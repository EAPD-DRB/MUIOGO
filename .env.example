# MUIOGO Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# ── Security ──────────────────────────────────────────────────────────────────

# Secret key used for Flask session signing.
# Run `python -c "import secrets; print(secrets.token_hex(32))"` to generate one.
# If unset, a random key is generated at startup (sessions won't survive restarts).
MUIOGO_SECRET_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────

# The origin that is allowed to make cross-origin requests to the API.
# Default: http://127.0.0.1:5002 (local development)
# Change to your production domain if deploying publicly.
MUIOGO_ALLOWED_ORIGIN=http://127.0.0.1:5002

# ── Server ────────────────────────────────────────────────────────────────────

# Port the Flask/waitress server will listen on.
PORT=5002

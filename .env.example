# =============================================================================
# MUIOGO Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# =============================================================================

# --- Flask Secret Key ---
# A cryptographically secure secret used for signing session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production (FLASK_ENV=production). If not set in development,
# a random key is auto-generated (sessions won't persist across restarts).
MUIOGO_SECRET_KEY=your-production-secret-key-here

# --- Flask Environment ---
# Controls application behavior:
#   development  — debug-friendly defaults, auto-generated secret key if missing
#   production   — strict checks, app refuses to start without MUIOGO_SECRET_KEY
FLASK_ENV=development
